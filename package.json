{
  "name": "kaj-blog",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend build manifest for Kaj's server-rendered blog",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "build": "npm run build:fonts && npm run build:css && npm run build:navigation-state && npm run build:theme && npm run build:js",
    "build:fonts": "node ./scripts/copy-fonts.mjs",
    "build:css": "tailwindcss -i ./static/src/styles.css -o ./static/dist/styles.css --minify",
    "build:navigation-state": "esbuild ./static/src/navigation-state.js --bundle --format=iife --outfile=./static/dist/navigation-state.js --minify",
    "build:theme": "esbuild ./static/src/theme.js --bundle --format=iife --outfile=./static/dist/theme.js --minify",
    "build:js": "esbuild ./static/src/app.js --bundle --format=esm --outfile=./static/dist/app.js --minify",
    "test:frontend": "node --test tests/frontend/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@tiptap/core": "3.28.0",
    "@tiptap/extension-code-block": "3.28.0",
    "@tiptap/extension-heading": "3.28.0",
    "@tiptap/extension-link": "3.28.0",
    "@tiptap/extension-list": "3.28.0",
    "@tiptap/extension-table": "3.28.0",
    "@tiptap/markdown": "3.28.0",
    "@tiptap/starter-kit": "3.28.0",
    "alpinejs": "3.15.12",
    "htmx.org": "2.0.10",
    "katex": "0.18.4",
    "lucide": "1.25.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/cli": "4.3.3",
    "esbuild": "0.28.1",
    "tailwindcss": "4.3.3"
  }
}
