# Select one explicit settings module. Development is the local default.
DJANGO_SETTINGS_MODULE=config.settings.development

# Production-only required values. They are intentionally blank: never use
# development/test identities or placeholders as production configuration.
DJANGO_SECRET_KEY=
KAJ_PUBLIC_URL=
KAJ_ADMIN_EMAIL=
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=
# Leave both blank when the self-hosted SMTP trusts only the application network.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
DATABASE_URL=
REDIS_URL=
KAJ_MEDIA_ROOT=
KAJ_INITIAL_ADMIN_PASSWORD=
KAJ_TRUSTED_PROXY_CIDRS=
KAJ_UMAMI_DATABASE_URL=
KAJ_UMAMI_APP_SECRET=
KAJ_UMAMI_WEBSITE_ID=
