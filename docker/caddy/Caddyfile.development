{
	admin off
	auto_https off
}

import /etc/caddy/media-delivery.caddy
import /etc/caddy/analytics-proxy.caddy

http://localhost {
	encode gzip
	route {
		import media_delivery
		import analytics_proxy
		handle_path /static/* {
			root * /srv/static
			header Cache-Control "no-cache"
			file_server
		}

		@private path /media/* /exports/* /backups/* /var/*
		respond @private 404
		@internal path /internal/*
		respond @internal 404

		reverse_proxy {$KAJ_CADDY_UPSTREAM:web:8000} {
			header_up -X-Kaj-Client-IP
			header_up X-Kaj-Client-IP {http.request.remote.host}
		}
	}
}

:80 {
	respond 421
}
