{
	admin off
	acme_ca {$KAJ_ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
}

import /etc/caddy/media-delivery.caddy

http://{$KAJ_PUBLIC_HOST} {
	redir https://{$KAJ_PUBLIC_HOST}{uri} permanent
}

:80 {
	respond 421
}

{$KAJ_PUBLIC_HOST} {
	encode gzip
	route {
		import media_delivery
		handle_path /static/* {
			root * /srv/static
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		@private path /media/* /exports/* /backups/* /var/*
		respond @private 404
		@internal path /internal/*
		respond @internal 404

		reverse_proxy {$KAJ_CADDY_UPSTREAM:web:8000} {
			header_up -X-Kaj-Client-IP
			header_up X-Kaj-Client-IP {http.request.remote.host}
		}
	}
}
