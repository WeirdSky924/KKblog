ARG BASE_IMAGE=registry.invalid/kajspace/base-image:required-build-arg
FROM ${BASE_IMAGE}

ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=${SOURCE_REVISION}

USER root
WORKDIR /app
COPY --chown=10001:10001 apps/ /app/apps/
COPY --chown=10001:10001 templates/ /app/templates/
COPY --chown=10001:10001 static/dist/ /app/static/dist/
USER 10001:10001
